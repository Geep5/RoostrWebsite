:8080 {
	root * /srv
	encode gzip
	# Canonical host is roostr.space. The old hostname and www redirect the
	# site and join links, but /app keeps serving everywhere: a browser vault's
	# key and outbox live in that origin's storage and must not be orphaned.
	@legacy {
		header_regexp host Host ^(getroostr\.fly\.dev|www\.roostr\.space)$
		not path /app /app/* /main.js /roostr_web.js /roostr_web_bg.wasm /engine.wasm /engine-core.json /fonts/*
	}
	redir @legacy https://roostr.space{uri} permanent
	# The app was previewed under /gpui/ before it served the whole site.
	redir /gpui /{?query} permanent
	@preview path_regexp preview ^/gpui(/.*)$
	redir @preview {re.preview.1}{?query} permanent
	# Each website page has its own HTML (its title and link-preview tags);
	# every other path - the workspace, /app/** - gets 200.html, and the app
	# routes from the address bar. Nothing is content-hashed, so everything
	# revalidates: a new build never runs a cached module against a new
	# engine. The build ships brotli and gzip copies of the large files.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html /200.html
		file_server {
			precompressed br gzip
		}
	}
}
