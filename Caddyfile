:8080 {
	root * /srv
	encode gzip
	# Everything revalidates by default (HTML shell, engine, manifest) so a new
	# build never runs against a cached core; hashed bundles are immutable.
	header Cache-Control "no-cache"
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html /200.html
	file_server
}
