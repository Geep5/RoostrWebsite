:8080 {
	root * /srv
	encode gzip
	# Hashed bundles are immutable; everything else (HTML shell, engine,
	# manifest) revalidates so a new build never runs against a cached core.
	handle /_app/immutable/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /200.html
		file_server
	}
}
